# Source receipts are byte-hashed: preserve their original line endings.
*.sh text eol=lf
/data/atlas*.json -text whitespace=cr-at-eol
# The generated large atlas has canonical LF; individual receipts stay byte-exact.
/data/atlas.json text eol=lf
/data/atlas_geometry.bin binary
/assets/map/atlas_terrain.webp binary
# Region fingerprints hash exact JSON and generator bytes across platforms.
/data/europe_geometry.json text eol=lf
/data/game_regions.json text eol=lf
# Preserve the exact admitted route bytes recorded by the packaged proof.
/data/naval_routes.json -text whitespace=cr-at-eol
# Historical save receipts must remain byte-exact across checkouts.
/tests/fixtures/*-original.json -text
/data/game_region_sources.json text eol=lf
/data/game_region_geometry.bin binary
/tools/game_regions.py text eol=lf
/tools/build_game_regions.py text eol=lf
/tools/test_game_regions.py text eol=lf
