extends SceneTree
## Externer Pakettest. Dieses Skript und die Koordinationsmarker liegen nie in res://.

const EXPECTATIONS_JSON := __EXPECTATIONS_JSON__
var expected: Dictionary = {}
var main
var protocol
var checks := 0
var failures: Array = []
var observed: Dictionary = {}
var acknowledgements: Array = []
var started_ms := 0
var finished := false

func _initialize() -> void:
	expected = JSON.parse_string(EXPECTATIONS_JSON)
	started_ms = Time.get_ticks_msec()
	process_frame.connect(_watchdog)
	call_deferred("_run")

func _run() -> void:
	var role: String = expected.role
	var profile: String = str(expected.profile).replace("\\", "/").to_lower()
	var user_dir := OS.get_user_data_dir().replace("\\", "/").to_lower()
	_check(user_dir.begins_with(profile + "/"), "Benutzerdaten verlassen das exklusive Testprofil: " + user_dir)
	_check(not FileAccess.file_exists("user://spielstand.json"), "Frisches Profil enthält bereits einen Einzelspielerspielstand.")
	_check(not FileAccess.file_exists("user://lan_partie.json"), "Frisches Profil enthält bereits einen WLAN-Spielstand.")
	_check(str(ProjectSettings.get_setting("application/config/version", "")) == str(expected.version), "Eingebettete Projektversion stimmt nicht.")
	_check(FileAccess.get_sha256(OS.get_executable_path()) == str(expected.exe_sha256), "Die gestartete EXE stimmt nicht mit dem eingefrorenen SHA-256 überein.")
	_check(not DirAccess.dir_exists_absolute("res://tests"), "Tests wurden versehentlich in das Spielpaket exportiert.")
	_check(not DirAccess.dir_exists_absolute("res://tools"), "Werkzeuge wurden versehentlich in das Spielpaket exportiert.")
	_check(OS.get_cmdline_user_args().has("--lan-release-run-id=" + str(expected.run_id)), "Der Prozess besitzt nicht die erwartete Laufkennung.")
	_check(OS.get_cmdline_user_args().has("--lan-release-role=" + role), "Der Prozess besitzt nicht die erwartete Rolle.")
	if not failures.is_empty():
		_finish()
		return
	protocol = load("res://scripts/LanProtocol.gd")
	var save_format = load("res://scripts/SaveGame.gd")
	if not _check(save_format != null and int(save_format.CURRENT_VERSION) == int(expected.schema_version), "Das Paket besitzt nicht das erwartete Speicherformat."):
		_finish()
		return
	var scene = load("res://scenes/Main.tscn")
	if not _check(protocol != null and scene is PackedScene, "Produktiver Main- oder Protokollcode fehlt im Paket."):
		_finish()
		return
	main = scene.instantiate()
	root.add_child(main)
	await process_frame
	await process_frame
	if not _check(main.lan_session != null and main.lan_menu != null and main.kernel != null and main.map_view != null, "Die tatsächliche Main-Szene besitzt keine vollständige WLAN-Oberfläche."):
		_finish()
		return
	main.lan_session.discovery_enabled = false
	main.lan_session.command_finished.connect(func(result: Dictionary): acknowledgements.append(result.duplicate(true)))
	main.lan_menu.nickname.text = "Paket-Host" if role == "host" else "Paket-Gast"
	main.lan_menu.room_name.text = "Paketprüfung " + str(expected.run_id).substr(0, 8)
	main.lan_menu.port_box.value = int(expected.port)
	main._show_lan_menu()
	if role == "host":
		await _host_case()
	else:
		await _guest_case()
	_finish()

func _host_case() -> void:
	var session = main.lan_session
	main.lan_menu.house_picker.select(0)
	main.lan_menu.host_button.pressed.emit()
	if not _check(session.phase == "lobby" and session.is_host and session.local_peer_id == 1, "Produktiver Hostbutton öffnet keine echte Lobby."):
		return
	_write_marker("listening")
	var both_ready := func():
		if session.players.size() != 2:
			return false
		for peer in session.players:
			if not bool(session.players[peer].ready):
				return false
		return true
	if not await _until(both_ready, "Zwei reale bereite Sitze"):
		return
	_check(session.players.size() == 2, "Host besitzt nicht genau zwei reale Spieler.")
	main.lan_menu.start_button.pressed.emit()
	if not await _until(func(): return session.phase == "playing" and main.game != null, "Start über den Main-Lobbybutton"):
		return
	_check_references(0)
	_check(main.game.speed == 0, "Paketpartie startet nicht pausiert.")
	var host_capital := str(main.game.houses[0].capital)
	# Ein günstiger echter Ausbau lässt die reguläre Startkasse für Armee/Fokus frei.
	var guest_capital := _development_province(1)
	var host_gold := int(main.game.houses[0].gold)
	var guest_gold := int(main.game.houses[1].gold)
	var host_dev := int(main.game.province(host_capital).dev)
	var guest_dev := int(main.game.province(guest_capital).dev)
	var host_cost: int = main.game.region_capacity(main.game.province(host_capital)).develop_cost
	var guest_cost: int = main.game.region_capacity(main.game.province(guest_capital)).develop_cost
	main._on_province_selected(host_capital)
	var result: Dictionary = main._dispatch({"id":"develop"})
	_check(bool(result.get("ok", false)), "Eigener Hostausbau wurde im Main-Pfad abgewiesen.")
	_check(int(main.game.houses[0].gold) == host_gold - host_cost and int(main.game.province(host_capital).dev) == host_dev + 1, "Hostausbau wurde nicht genau einmal berechnet.")
	_check(int(main.game.houses[1].gold) == guest_gold, "Hostausbau belastete das Gasthaus.")
	_write_marker("built")
	if not await _until(func(): return int(main.game.houses[1].gold) <= guest_gold - guest_cost and int(main.game.province(guest_capital).dev) == guest_dev + 1, "Echter Gastausbau beim Host"):
		return
	if not await _until(func(): return _marker_exists("guest", "actions-complete"), "Gast hat echte Bestätigungen und Ablehnung beobachtet"):
		return
	_check_references(0)
	_check(int(main.game.houses[0].gold) == host_gold - host_cost and int(main.game.province(host_capital).dev) == host_dev + 1, "Abgewiesener Gastbefehl veränderte das Hosthaus.")
	var actions := _marker("guest", "actions-complete").get("actions",{}) as Dictionary
	if not _check(not actions.is_empty() and str(actions.get("world_hash","")) == protocol.world_hash(main.game.snapshot()), "Host bestätigt nicht denselben Fokus-/Armee-Endstand wie der echte Gast."):
		return
	for key in ["focus_province","focus_cost","focus_changed_month","army_id","march_from","march_to"]:
		observed[key] = actions.get(key)
	_check(int(main.game.houses[1].gold) == guest_gold-guest_cost-int(actions.focus_cost)-50, "Gastbefehle buchen Fokus und Armee genau einmal beim Host.")
	if not await _host_save_resume(actions):
		return
	_capture_world()
	_write_marker("world-ready")
	if not await _until(func(): return _marker_exists("guest", "observed"), "Gast hat denselben endgültigen Paketstand beobachtet"):
		return
	if not await _until(func(): return session.players.size() == 1, "Geordnetes Ende des echten Gastprozesses"):
		return
	_check(main.game.speed == 0, "Host läuft nach Gastende weiter.")
	_check(str(observed.world_hash) == str(protocol.world_hash(main.game.snapshot())), "Gastende veränderte die eingefrorene Welt.")
	session.close_session("Isolierte Paketprüfung abgeschlossen.")

func _guest_case() -> void:
	var session = main.lan_session
	main.lan_menu.address.text = "127.0.0.1"
	main.lan_menu.join_button.pressed.emit()
	if not await _until(func(): return session.phase == "lobby" and session.local_peer_id > 1, "Echter Gastbeitritt über Main"):
		return
	main.lan_menu.house_picker.select(1)
	main.lan_menu.house_picker.item_selected.emit(1)
	main.lan_menu.ready_button.pressed.emit()
	if not await _until(func(): return session.phase == "playing" and main.game != null, "Gast erhielt produktiven Startsnapshot"):
		return
	_check_references(1)
	_check(not main.start_layer.visible and not main.lan_menu.visible, "Gast bleibt nach dem Start im Titel oder in der Lobby.")
	_check(main.game.speed == 0, "Gastpartie startet nicht pausiert.")
	if not await _until(func(): return _marker_exists("host", "built"), "Host hat eigene Main-Aktion abgeschlossen"):
		return
	var host_capital := str(main.game.houses[0].capital)
	var guest_capital := _development_province(1)
	var base_houses: Array = main.DataScript.houses()
	var base_provinces: Array = main.DataScript.provinces()
	var base_host_dev := -1
	for province in base_provinces:
		if str(province.id) == host_capital:
			base_host_dev = int(province.dev)
	var host_cost: int = main.game.region_capacity(main.game.province(host_capital)).develop_cost
	var guest_cost: int = main.game.region_capacity(main.game.province(guest_capital)).develop_cost
	if not await _until(func(): return int(main.game.houses[0].gold) == int(base_houses[0].gold) - host_cost and int(main.game.province(host_capital).dev) == base_host_dev + 1, "Hostausbau kam als echter Gast-Snapshot an"):
		return
	_check_references(1)
	var guest_gold := int(main.game.houses[1].gold)
	var guest_dev := int(main.game.province(guest_capital).dev)
	main._on_province_selected(guest_capital)
	var previous_acks := acknowledgements.size()
	var result: Dictionary = main._dispatch({"id":"develop"})
	_check(bool(result.get("ok", false)) and session.pending_command, "Gastausbau wurde nicht als ausstehender echter Befehl versendet.")
	if not await _until(func(): return acknowledgements.size() > previous_acks and not session.pending_command and int(main.game.houses[1].gold) == guest_gold - guest_cost, "Gast erhielt echte Hostbestätigung und neuen Main-Snapshot"):
		return
	var success: Dictionary = acknowledgements[-1]
	var success_text := str(success.get("message", ""))
	_check(bool(success.get("ok", false)) and not success_text.is_empty(), "Host bestätigte eigenen Gastausbau nicht erfolgreich.")
	_check(int(main.game.province(guest_capital).dev) == guest_dev + 1, "Gastausbau erhöhte die Entwicklung nicht genau einmal.")
	_check(main.hint_label.text.contains(success_text) and not main.hint_label.text.contains("gesendet"), "Echte Gastbestätigung fehlt im sichtbaren Main-Hinweis.")
	_check_references(1)
	_check(str(main.selected) == guest_capital and str(main.map_view.selected) == guest_capital, "Gast-Snapshot verlor die lokale Provinzauswahl.")
	observed["accepted_message"] = success_text
	var before_hash := str(protocol.world_hash(main.game.snapshot()))
	main._on_province_selected(host_capital)
	previous_acks = acknowledgements.size()
	result = main._dispatch({"id":"develop"})
	_check(bool(result.get("ok", false)), "Bewusst ungültiger Gastbefehl erreichte den Transport nicht.")
	if not await _until(func(): return acknowledgements.size() > previous_acks and not session.pending_command, "Gast erhielt echte Ablehnung des fremden Provinzbefehls"):
		return
	var rejection: Dictionary = acknowledgements[-1]
	var rejection_text := str(rejection.get("message", ""))
	_check(not bool(rejection.get("ok", true)) and not rejection_text.is_empty(), "Fremde Hostprovinz wurde akzeptiert oder ohne Begründung abgewiesen.")
	_check(main.hint_label.text.contains(rejection_text) and not main.hint_label.text.contains("gesendet"), "Die tatsächliche Hostablehnung fehlt im sichtbaren Gasthinweis.")
	_check(str(protocol.world_hash(main.game.snapshot())) == before_hash, "Abgewiesener fremder Provinzbefehl änderte die Paketwelt.")
	_check(int(main.game.houses[1].gold) == guest_gold - guest_cost, "Abgewiesener Befehl kostete den Gast weiteres Gold.")
	observed["rejected_message"] = rejection_text
	observed["rejected_hint"] = str(main.hint_label.text)
	var actions := await _guest_extended_actions(host_capital)
	if actions.is_empty():
		return
	_write_marker("actions-complete",{"actions":actions})
	if not await _guest_save_resume(actions):
		return
	if not await _until(func(): return _marker_exists("host", "world-ready"), "Host hat endgültigen tatsächlichen Paketstand eingefroren"):
		return
	_check_references(1)
	_capture_world()
	_write_marker("observed")
	session.close_session("Gast der Paketprüfung ist fertig.")

func _guest_command(command: Dictionary, stage: String) -> Dictionary:
	var previous := acknowledgements.size()
	var sent: Dictionary = main._dispatch(command)
	if not _check(bool(sent.get("ok",false)) and main.lan_session.pending_command, stage+": Befehl wurde nicht als echte Gastanfrage versendet."):
		return {}
	if not await _until(func(): return acknowledgements.size()>previous and not main.lan_session.pending_command, stage+": Hostantwort und Snapshot"):
		return {}
	_check_references(1)
	return acknowledgements[-1]

func _development_province(house: int) -> String:
	var candidates: Array = []
	for province in main.game.provinces:
		if int(province.owner)==house and int(province.dev)<10:
			candidates.append({"id":str(province.id),"cost":int(main.game.region_capacity(province).develop_cost)})
	candidates.sort_custom(func(a: Dictionary,b: Dictionary) -> bool:
		return a.cost<b.cost if a.cost!=b.cost else a.id<b.id)
	return str(candidates[0].id) if not candidates.is_empty() else ""

func _guest_extended_actions(host_capital: String) -> Dictionary:
	var own: Array = []
	for province in main.game.provinces:
		if int(province.owner) == 1:
			own.append(str(province.id))
	own.sort()
	var focus_province := ""
	var focus_cost := 2147483647
	var march_from := ""
	var march_to := ""
	for id in own:
		var cost := maxi(1,roundi(20.0*float(main.game.province(id).economic_share)))
		if cost < focus_cost:
			focus_cost = cost
			focus_province = id
		var neighbours: Array = main.game.neighbours(id).duplicate()
		neighbours.sort()
		for target in neighbours:
			if march_from == "" and int(main.game.province(str(target)).get("owner",-1)) == 1:
				march_from = id
				march_to = str(target)
	if not _check(focus_province != "" and march_from != "" and int(main.game.houses[1].gold)>=focus_cost+50, "Reguläre Gastkasse oder eigene benachbarte Marschroute reicht für Fokus/Armee nicht."):
		return {}
	var gold := int(main.game.houses[1].gold)
	var month := int(main.game.calendar_index())
	main._on_province_selected(focus_province)
	var result := await _guest_command({"id":"province_focus","focus":"agriculture"},"Eigene Kornkammer")
	if not _check(bool(result.get("ok",false)),"Echte Gast-Kornkammer wurde abgewiesen."):
		return {}
	_check(int(main.game.houses[1].gold)==gold-focus_cost and str(main.game.province(focus_province).economic_focus)=="agriculture" and int(main.game.province(focus_province).focus_changed_month)==month,"Fokus bucht Kosten und Bindungsbeginn nicht genau einmal.")
	var hash_before := str(protocol.world_hash(main.game.snapshot()))
	result = await _guest_command({"id":"province_focus","focus":"trade"},"Fokusbindung")
	_check(not bool(result.get("ok",true)) and protocol.world_hash(main.game.snapshot())==hash_before,"Gast umgeht die zwölfmonatige Schwerpunktbindung.")
	main._on_province_selected(host_capital)
	result = await _guest_command({"id":"province_focus","focus":"agriculture"},"Fremder Schwerpunkt")
	_check(not bool(result.get("ok",true)) and protocol.world_hash(main.game.snapshot())==hash_before,"Gast verändert einen fremden Schwerpunkt oder dessen Kasse.")
	main._on_province_selected(march_from)
	result = await _guest_command({"id":"army"},"Eigene Feldarmee")
	if not _check(bool(result.get("ok",false)) and main.game.houses[1].armies.size()==1,"Gast stellt über Main keine echte eigene Feldarmee auf."):
		return {}
	var army: Dictionary = main.game.houses[1].armies[0]
	var army_id := int(army.id)
	var strength := int(army.strength)
	result = await _guest_command({"id":"select_army","army":army_id},"Eigene Armeewahl")
	_check(bool(result.get("ok",false)) and int(main.game.houses[1].armies[0].id)==army_id and int(main.game.houses[1].armies[0].strength)==strength,"Echte Armeewahl verlor ID oder Truppen.")
	main._on_province_selected(march_to)
	result = await _guest_command({"id":"march"},"Angrenzender eigener Marsch")
	if not _check(bool(result.get("ok",false)) and str(main.game.houses[1].armies[0].province)==march_to,"Echter Gastmarsch erreicht seine benachbarte Provinz nicht."):
		return {}
	_check(int(main.game.houses[1].gold)==gold-focus_cost-50 and int(main.game.houses[1].armies[0].strength)==strength and main.game.calendar_index()==month,"Auswahl/Marsch erzeugten zusätzliche Kosten, Truppen oder Zeit.")
	var actions := {"focus_province":focus_province,"focus_cost":focus_cost,"focus_changed_month":month,"army_id":army_id,"march_from":march_from,"march_to":march_to,"world_hash":protocol.world_hash(main.game.snapshot())}
	for key in actions:
		if key != "world_hash": observed[key] = actions[key]
	observed["focus_verified"] = true
	observed["army_commands_verified"] = true
	return actions

func _host_save_resume(actions: Dictionary) -> bool:
	var session = main.lan_session
	var before_hash := str(protocol.world_hash(main.game.snapshot()))
	main.lan_menu.save_button.pressed.emit()
	var saved = JSON.parse_string(FileAccess.get_file_as_string("user://lan_partie.json"))
	if not _check(saved is Dictionary and int(saved.get("state",{}).get("schema_version",0))==int(expected.schema_version) and saved.get("fingerprint")==session._fingerprint,"Produktiver Speichernbutton schreibt keinen aktuellen WLAN-Stand."):
		return false
	_check(protocol.world_hash(saved.state)==before_hash,"Gespeicherte Paketwelt unterscheidet sich vom bestätigten Hoststand.")
	main.lan_menu.lobby_button.pressed.emit()
	if not await _until(func(): return session.phase=="lobby", "Produktive Rückkehr zur Fortsetzungslobby"):
		return false
	var loaded: Dictionary = session.load_host_lobby()
	if not _check(bool(loaded.get("ok",false)) and session.is_resuming(),"Der echte gespeicherte aktuelles Schema-Stand kann nicht geladen werden."):
		return false
	_check(protocol.world_hash(session.game.snapshot())==before_hash,"Laden verändert den Fokus-/Armee-Spielstand.")
	_write_marker("loaded")
	if not await _until(func():
		if session.players.size()!=2: return false
		for peer in session.players:
			if not bool(session.players[peer].ready): return false
		return true, "Beide Prozesse zur gespeicherten Fortsetzung bereit"):
		return false
	main.lan_menu.start_button.pressed.emit()
	if not await _until(func(): return session.phase=="playing" and main.game==session.game,"Produktive aktuelles Schema-Fortsetzung"):
		return false
	_check_references(0)
	_check(protocol.world_hash(main.game.snapshot())==before_hash,"Wiederaufgenommene Paketwelt änderte ihren Inhalt.")
	_check(str(main.game.province(str(actions.focus_province)).economic_focus)=="agriculture" and int(main.game.houses[1].armies[0].id)==int(actions.army_id) and str(main.game.houses[1].armies[0].province)==str(actions.march_to),"Fokus, Armeewahl oder Marschziel gehen beim Fortsetzen verloren.")
	observed["focus_verified"] = true
	observed["army_commands_verified"] = true
	observed["current_schema_resume_verified"] = true
	_write_marker("resumed")
	return await _until(func(): return _marker_exists("guest","resume-verified"),"Gast prüft gespeicherte Fokus-/Marschbindung")

func _guest_save_resume(actions: Dictionary) -> bool:
	var session = main.lan_session
	if not await _until(func(): return session.phase=="lobby" and session.is_resuming(),"Gast erhält aktuelles Schema-Fortsetzungslobby"):
		return false
	if not await _until(func(): return _marker_exists("host","loaded"),"Host hat den tatsächlichen Paketspielstand geladen"):
		return false
	main.lan_menu.ready_button.pressed.emit()
	if not await _until(func(): return session.phase=="playing" and main.game==session.game,"Gast erhält gespeicherten Startsnapshot"):
		return false
	if not await _until(func(): return _marker_exists("host","resumed"),"Host bestätigt gespeicherte Fortsetzung"):
		return false
	_check_references(1)
	_check(main.game.snapshot().schema_version==int(expected.schema_version) and str(main.game.province(str(actions.focus_province)).economic_focus)=="agriculture" and int(main.game.province(str(actions.focus_province)).focus_changed_month)==int(actions.focus_changed_month),"Gast verlor aktuelles Schema oder Schwerpunktbindung nach Laden.")
	_check(int(main.game.houses[1].armies[0].id)==int(actions.army_id) and str(main.game.houses[1].armies[0].province)==str(actions.march_to),"Gast verlor gespeicherte Armeewahl oder Marschposition.")
	var before_hash := str(protocol.world_hash(main.game.snapshot()))
	main._on_province_selected(str(actions.focus_province))
	var result := await _guest_command({"id":"province_focus","focus":"trade"},"Gespeicherte Schwerpunktbindung")
	_check(not bool(result.get("ok",true)),"Save/Resume umgeht die Schwerpunktbindung.")
	main._on_province_selected(str(actions.march_from))
	result = await _guest_command({"id":"march"},"Gespeicherte monatliche Marschsperre")
	_check(not bool(result.get("ok",true)) and protocol.world_hash(main.game.snapshot())==before_hash,"Save/Resume umgeht die Monatsgrenze oder verändert abgewiesene Befehle.")
	observed["current_schema_resume_verified"] = true
	_write_marker("resume-verified")
	return true

func _check_references(house: int) -> void:
	_check(main.game == main.lan_session.game and main.kernel.game == main.game and main.map_view.game == main.game, "Main, Session, Kernel oder Karte verwendet einen alten Snapshot.")
	_check(int(main.game.player) == house and main.lan_session.local_house() == house, "Persönliche Paketperspektive gehört zum falschen Haus.")
	_check(main.kernel.top_modal() == "game", "Nach dem Start blieb ein unerwartetes Modal aktiv.")

func _capture_world() -> void:
	observed["world_hash"] = str(protocol.world_hash(main.game.snapshot()))
	observed["revision"] = int(main.lan_session.revision)
	observed["personal_house"] = int(main.game.player)
	observed["local_peer_id"] = int(main.lan_session.local_peer_id)
	observed["month_index"] = int(main.game.calendar_index())
	observed["house_gold"] = [int(main.game.houses[0].gold), int(main.game.houses[1].gold)]
	observed["capital_development"] = [int(main.game.province(str(main.game.houses[0].capital)).dev), int(main.game.province(str(main.game.houses[1].capital)).dev)]
	observed["developed_guest_province"] = _development_province(1)
	observed["references_current"] = main.game == main.lan_session.game and main.kernel.game == main.game and main.map_view.game == main.game
	observed["schema_version"] = int(main.game.snapshot().schema_version)

func _until(condition: Callable, stage: String) -> bool:
	var deadline := Time.get_ticks_msec() + int(expected.phase_timeout_ms)
	while not finished and Time.get_ticks_msec() < deadline:
		if condition.call():
			return true
		if main != null and main.lan_session.phase == "disconnected":
			_check(false, stage + ": Verbindung beendet: " + str(main.lan_session.status))
			return false
		await create_timer(0.025).timeout
	_check(false, "Zeitüberschreitung: " + stage)
	return false

func _marker_exists(role: String, stage: String) -> bool:
	return not _marker(role,stage).is_empty()

func _marker(role: String, stage: String) -> Dictionary:
	var path := str(expected.output) + "/" + role + "-" + stage + ".json"
	if not FileAccess.file_exists(path):
		return {}
	# A concurrently published Windows marker may still be temporarily unreadable.
	# Poll again without making a transient probe emit an engine error.
	var raw := FileAccess.get_file_as_string(path)
	if raw.is_empty():
		return {}
	var parser := JSON.new()
	if parser.parse(raw) != OK:
		return {}
	var marker = parser.data
	return marker if marker is Dictionary and marker.get("run_id") == expected.run_id and marker.get("role") == role and marker.get("stage") == stage else {}

func _write_marker(stage: String, payload: Dictionary = {}) -> void:
	var marker := {
		"run_id":expected.run_id, "role":expected.role, "stage":stage,
		"pid":OS.get_process_id(), "elapsed_ms":Time.get_ticks_msec() - started_ms}
	marker.merge(payload)
	_write_json(str(expected.output) + "/" + str(expected.role) + "-" + stage + ".json",marker)

func _write_json(path: String, value: Dictionary) -> void:
	var temporary := path + ".tmp-" + str(OS.get_process_id())
	var file := FileAccess.open(temporary, FileAccess.WRITE)
	if file == null:
		_check(false, "Testbeleg konnte nicht geschrieben werden: " + path)
		return
	file.store_string(JSON.stringify(value, "\t") + "\n")
	file.close()
	_check(DirAccess.rename_absolute(temporary, path) == OK, "Testbeleg konnte nicht abgeschlossen werden: " + path)

func _watchdog() -> void:
	if not finished and Time.get_ticks_msec() - started_ms > int(expected.overall_timeout_ms):
		_check(false, "Gesamtfrist der isolierten Paketprüfung überschritten.")
		_finish()

func _check(ok: bool, message: String) -> bool:
	checks += 1
	if not ok:
		failures.append(message)
		print("PACKAGED_LAN_SMOKE FAIL: " + message)
	return ok

func _finish() -> void:
	if finished:
		return
	finished = true
	var report := {"stage":"packaged-lan-main-smoke", "run_id":expected.get("run_id", ""),
		"role":expected.get("role", ""), "pid":OS.get_process_id(),
		"version":str(ProjectSettings.get_setting("application/config/version", "")),
		"exe":OS.get_executable_path(), "exe_sha256":expected.get("exe_sha256", ""),
		"checks":checks, "failures":failures.duplicate(), "observed":observed,
		"user_data":OS.get_user_data_dir(), "elapsed_ms":Time.get_ticks_msec() - started_ms,
		"real_android_wlan_verified":false}
	if main != null:
		main.lan_session.close_session("Isolierte Paketprüfung beendet.")
	_write_json(str(expected.output) + "/" + str(expected.role) + "-result.json", report)
	print("PACKAGED_LAN_SMOKE %s; role=%s; pid=%d; %d Prüfungen." % ["OK" if failures.is_empty() else "FAIL", expected.get("role", ""), OS.get_process_id(), checks])
	quit(0 if failures.is_empty() else 1)
